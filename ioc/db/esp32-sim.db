record(ai, "ESP32:TEMP") {
	field(DESC, "Simulated temperature")
	field(DTYP, "Soft Channel")
	field(INP, "SIM:TEMP:SRC CP")
	field(EGU, "degC")
	field(PREC, "1")
	field(SCAN, "Passive")
}

record(ai, "ESP32:HUMIDITY") {
	field(DESC, "Simulated relative humidity")
	field(DTYP, "Soft Channel")
	field(INP, "SIM:HUMIDITY:SRC CP")
	field(EGU, "%")
	field(PREC, "1")
	field(SCAN, "Passive")
}

record(bo, "ESP32:LED") {
	field(DESC, "Requested LED state")
	field(DTYP, "Soft Channel")
	field(ZNAM, "OFF")
	field(ONAM, "ON")
	field(VAL, "0")
}

record(bi, "ESP32:LED:RBV") {
	field(DESC, "Reported LED state")
	field(DTYP, "Soft Channel")
	field(INP, "ESP32:LED CP")
	field(ZNAM, "OFF")
	field(ONAM, "ON")
	field(SCAN, "Passive")
}

record(calc, "SIM:TEMP:SRC") {
	field(DESC, "Temperature simulator")
	field(SCAN, "1 second")
	field(CALC, "25 + 5 * RNDM")
	field(PREC, "1")
}

record(calc, "SIM:HUMIDITY:SRC") {
	field(DESC, "Humidity simulator")
	field(SCAN, "1 second")
	field(CALC, "55 + 20 * RNDM")
	field(PREC, "1")
}

